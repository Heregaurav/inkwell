# Root-level Docker Compose interpolation values. Replace placeholders locally.
# Never commit a populated .env file.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_SAME_SITE=lax
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local backend process only (backend/.env.example is the canonical backend template).
PORT=5000
MONGO_URI=mongodb://localhost:27017/inkwell_db

# Frontend local development only; Vite uses this from frontend/.env.
VITE_API_URL=http://localhost:5000

# Vercel server-side function only. Set in Vercel dashboard, not in browser env.
BACKEND_ORIGIN=https://<your-backend-host>